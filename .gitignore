# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
*.swp
*.swo
*.swn
*~
.vscode/
.idea/

# Env / logs / general temp files
.env
.env.local
*.log
*.tmp

# Crystal (matches `crystal init`'s own template, which also skips
# shard.lock for libraries - dependency locking is for the applications
# that consume a shard, not the shard itself; ruby-tryst does the same
# with Gemfile.lock)
/docs/
/lib/
/bin/
/.shards/
*.dwarf
/shard.lock

# Compiled Crystal binaries have no distinguishing file extension
# (`crystal build foo.cr` with no -o produces a plain `foo`), so there's
# no reliable name/extension pattern to add here. Instead a pre-commit
# hook should be setup to inspect staged files to test if they look like
# a built binary

# Phase-0 HTML/CSS design mocks (approved as a visual reference, never
# built as part of the app) - same /design/ convention every widget
# shard's own .gitignore already uses.
/design/

# Sentinel that opts a local clone into the pre-commit hook's Haiku-
# powered comment-verbosity review (see .githooks/pre-commit) - a repo-
# local preference, not something to force on every future public
# contributor who may have no Claude Code/API access at all.
/.enable-claude-comment-review
