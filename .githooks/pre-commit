#!/bin/sh
# Activate once per clone: git config core.hooksPath .githooks
set -eu

# --- 1. Ameba lint check ---------------------------------------------
# Runs over the whole tree rather than just staged files - simplest
# option at this project's size, and it means a lint issue introduced by
# an uncommitted change elsewhere can't slip through unnoticed either.
# Every other shard is listed explicitly: each is separate, with its own
# shard.yml, but lives in this repo and shares its lint rules. Their
# lib/ dirs are deliberately not passed - those are vendored
# dependencies.
ameba_bin="lib/ameba/bin/ameba"
if [ -x "$ameba_bin" ]; then
  if ! "$ameba_bin" src/ spec/ examples/ \
    tryst-value-slider/src/ tryst-value-slider/spec/ tryst-value-slider/examples/ \
    tryst-spinner/src/ tryst-spinner/spec/ tryst-spinner/examples/ \
    tryst-dnd/src/ tryst-dnd/spec/ tryst-dnd/examples/ \
    tryst-segmented/src/ tryst-segmented/spec/ tryst-segmented/examples/ \
    tryst-range-slider/src/ tryst-range-slider/spec/ tryst-range-slider/examples/; then
    echo "pre-commit: ameba found issues (see above) - fix or run 'crystal tool format' first." >&2
    exit 1
  fi
else
  echo "pre-commit: $ameba_bin not found - run 'shards install' first." >&2
  exit 1
fi

# --- 2. Typecheck every example ---------------------------------------
# Nothing else does: `crystal spec` never touches examples/, and ameba
# above only lints it - so an example could stop COMPILING and nothing
# would notice until someone ran that one file. A src change is the usual
# culprit, which is why this runs unconditionally rather than only when
# an example is staged.
#
# Deliberately ONLY "does it compile". Not run (they open native modal
# dialogs and block on mainloop - they are manual harnesses by nature),
# and not realized either.
#
# --no-codegen matters twice: it is much faster, and it emits NO binary,
# so this can't leave behind the very stray executable step 3 exists to
# refuse. Every .cr under examples/ is checked, entry point or not - the
# library-ish ones (a service, a buffer) typecheck standalone too, so
# there's no list to keep in sync.
# This is the first step here to need `crystal` itself on PATH, and a git
# hook does not always inherit a login shell's - a GUI git client is the
# usual way to get a stripped one. Say so outright rather than letting
# every example "fail to compile" with a command-not-found.
if ! command -v crystal >/dev/null 2>&1; then
  echo "pre-commit: 'crystal' is not on PATH, so examples/ can't be typechecked." >&2
  echo "Commit from a shell where 'crystal -v' works, or add it to the hook's PATH." >&2
  exit 1
fi

# Each shard's examples are checked FROM ITS OWN DIRECTORY. A shard-name
# require like `require "tryst/ui"` resolves against the lib/ of whatever
# directory crystal runs in, and each sibling shard has its own - checking
# its examples from the repo root would look in the root's lib/ and fail
# to find tryst at all. A shard with no examples/ directory at all is
# skipped rather than treated as a failure - `find` on a missing dir
# would otherwise abort the whole hook.
example_failures=""
check_examples() {
  dir=$1
  [ -d "$dir/examples" ] || return 0
  if [ ! -d "$dir/lib" ]; then
    echo "pre-commit: $dir/lib is missing - run 'shards install' in $dir." >&2
    exit 1
  fi
  for f in $( (cd "$dir" && find examples -name '*.cr' | sort) ); do
    if ! out=$( (cd "$dir" && crystal build --no-codegen "$f") 2>&1 ); then
      example_failures="$example_failures
--- $dir/$f
$out"
    fi
  done
}

check_examples .
check_examples tryst-value-slider
check_examples tryst-spinner
check_examples tryst-dnd
check_examples tryst-segmented
check_examples tryst-range-slider

if [ -n "$example_failures" ]; then
  echo "pre-commit: example(s) failed to compile:" >&2
  printf '%s\n' "$example_failures" >&2
  echo "An example that doesn't compile is dead documentation - fix it or delete it." >&2
  exit 1
fi

# --- 3. Refuse compiled executables -----------------------------------
# Compiled Crystal binaries have no distinguishing file extension
# (`crystal build foo.cr` with no -o produces a plain `foo`), so a
# name/extension-based .gitignore entry can't reliably catch a stray one
# - this checks actual file content instead.
staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$staged" ]; then
  bad=""
  for f in $staged; do
    [ -f "$f" ] || continue
    desc=$(file -b -- "$f")
    case "$desc" in
      *Mach-O*executable*|*ELF*executable*|*PE32*executable*)
        bad="$bad
$f: $desc"
        ;;
    esac
  done

  if [ -n "$bad" ]; then
    echo "pre-commit: refusing to commit compiled executable(s):" >&2
    printf '%s\n' "$bad" >&2
    echo "Build artifacts belong outside the repo (scratch/tmp)." >&2
    exit 1
  fi
fi

# --- 4. Refuse bead/tracker ids anywhere in the tree -------------------
# Beads is internal to the workflow; a bead id in a comment or doc means
# nothing to a reader and leaks the internal process into permanent
# history. Checks the STAGED content (git grep --cached), not the
# working tree, so this can't be fooled by fixing a file without
# re-staging it.
#
# Scans the WHOLE repo (pathspec excludes only .githooks/.claude/.beads,
# which legitimately need to talk about the pattern itself or hold the
# tracker's own real data) rather than a fixed list of source dirs - a
# per-directory allowlist is exactly how this went unnoticed in
# tryst-vector/ (a whole shard added after the list was written) and in
# every README.md/Dockerfile in the repo, none of which "src/* spec/*
# examples/* tryst-sdl/*" was ever going to match.
#
# The pattern itself was ALSO wrong until now: ctk-[a-z][0-9]+ assumes
# one letter then digits, but this tracker's real ids are three mixed
# alphanumeric characters in any order (ctk-yxa, ctk-0au, ctk-3x6) - the
# old pattern couldn't match ANY of them, so this check has been passing
# vacuously since it was written. Verified the fix against every real id
# from this session's own bd history before relying on it.
if [ -n "$staged" ]; then
  hits=$(git grep -n --cached -E 'ctk-[a-z0-9]{3}(\.[0-9]+)*' -- . ':!.githooks' ':!.claude' ':!.beads' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "pre-commit: refusing to commit bead/tracker id(s):" >&2
    printf '%s\n' "$hits" >&2
    echo "Describe the change/rationale itself instead of pointing at the bead." >&2
    exit 1
  fi
fi

# --- 5. Comment-verbosity review (WARN only, never blocks) ------------
# Runs LAST, after every hard-fail gate above - this is the slow one
# (~30-40s, a real Haiku call), so a commit that's broken for a real
# reason fails fast on ameba/typecheck without waiting on this too.
# WARN-only by deliberate choice, not a limitation: this is a judgment
# call a human should weigh, not something that should ever block a
# commit outright.
#
# Opt-in via a gitignored sentinel file at the repo root
# (.enable-claude-comment-review, empty/any content, presence is all
# that matters) - this repo is headed public, and forcing every future
# contributor's pre-commit hook to shell out to Claude Code isn't
# reasonable to assume by default the way ameba/crystal are. Touch that
# file once locally to opt in.
#
# Never fails the commit for its OWN sake either - no `claude` on PATH,
# no `timeout`/`gtimeout`, a network hiccup, not logged in, whatever -
# all of that just skips the check silently rather than treating "the
# reviewer itself didn't run" as a reason to block.
comment_review_bin=""
if command -v timeout >/dev/null 2>&1; then
  comment_review_bin="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  comment_review_bin="gtimeout"
fi

if [ -f ".enable-claude-comment-review" ] && [ -n "$comment_review_bin" ] && command -v claude >/dev/null 2>&1; then
  comment_diff=$(git diff --cached -- '*.cr' 2>/dev/null || true)
  if [ -n "$comment_diff" ]; then
    # Cap what gets sent - keeps this fast and cheap even for a large
    # commit; a truncated diff still gives real signal on whatever
    # comments appear first, which is good enough for a WARN-only check.
    comment_diff=$(printf '%s' "$comment_diff" | head -c 20000)

    review_prompt="You are a strict code-comment reviewer for a Crystal codebase. Look at the comment lines that were ADDED (lines starting with + that are # comments) in the diff below, and judge whether each comment block is doing its job well.

A GOOD comment explains a non-obvious WHY: a hidden constraint, an invariant, a workaround, something that would surprise a reader. It's as short as it can be while still conveying that.

A BAD comment is narrative bloat: it re-explains what the code obviously does, narrates the history/process of how the author arrived at the change, over-justifies a simple decision with multiple redundant sentences making the same point, or reads like a mini-essay when one sentence would do.

Here is the diff:

\`\`\`
${comment_diff}
\`\`\`

Respond in this exact format, nothing else:
VERDICT: PASS or WARN
REASON: (if WARN) point to the specific comment block(s) that are bloated, one sentence each on what's wrong and how to cut it down. If PASS, say so in one sentence."

    review_result=$(printf '%s' "$review_prompt" | "$comment_review_bin" 60 claude -p --model haiku --allowedTools "" 2>/dev/null || true)

    # The model's own response starts with "VERDICT: WARN"/"VERDICT: PASS"
    # (matching the format the prompt asks for), not "WARN" at position 0 -
    # *WARN* (WARN anywhere in the string) is what actually matches that.
    case "$review_result" in
      *WARN*)
        echo "" >&2
        echo "pre-commit: comment review (WARN only, not blocking):" >&2
        printf '%s\n' "$review_result" >&2
        echo "" >&2
        ;;
    esac
  fi
fi
