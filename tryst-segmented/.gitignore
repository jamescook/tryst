# The root .gitignore anchors its Crystal entries to the repo root
# (/lib/, /.shards/, /shard.lock), so this shard needs its own copies.
/lib/
/.shards/
/shard.lock
/docs/
/bin/
*.dwarf

# Phase-0 design mockups (design/mock.html) are a review artifact, not
# something meant to land in git history - accidentally committed once
# already for a sibling shard before this line existed there.
/design/
